# ---------------------------------------------------------------------------
# Tweaker — Seer-compatible service for self-hosted Sentry
# ---------------------------------------------------------------------------

# Sentry's internal API base, reachable from the Tweaker container.
# In Sentry's Docker Compose network this is usually http://sentry:9000.
TWEAKER_SENTRY_URL=http://sentry:9000

# Shared secrets. Generate each with:
#   openssl rand -hex 32
# Set the SAME values in Sentry (SEER_API_SHARED_SECRET /
# SEER_RPC_SHARED_SECRET) and restart both services.
SEER_API_SHARED_SECRET=replace-me-with-a-64-character-hex-secret
SEER_RPC_SHARED_SECRET=replace-me-with-a-different-64-character-hex-secret
# Per-IP Seer API rate limit. Set 0 to disable.
TWEAKER_SEER_RATE_LIMIT_PER_MINUTE=600
# Maximum accepted request body size in bytes.
TWEAKER_MAX_REQUEST_BYTES=50000000

# Encrypts integration credentials in the operator console.
# Generate with: openssl rand -base64 32
TWEAKER_SECRET_KEY=

# Optional: protect the operator console. Sentry uses the Seer secrets above,
# not this token.
TWEAKER_AUTH_TOKEN=

# Storage
TWEAKER_DATA_DIR=./data
TWEAKER_DATABASE_URL=sqlite:///./data/tweaker.db
# For Docker Compose:
# TWEAKER_DATABASE_URL=postgresql+psycopg://tweaker:tweaker@postgres:5432/tweaker

# Background execution: inline for local dev, arq for production.
TWEAKER_RUNNER=inline
TWEAKER_REDIS_URL=redis://localhost:6379/0

# AI provider: auto | anthropic | openai | demo | none
# Set false for OpenAI-compatible servers that do not implement tool calling.
TWEAKER_AGENT_TOOL_LOOP=true
TWEAKER_AI_PROVIDER=auto
ANTHROPIC_API_KEY=
# TWEAKER_ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI-compatible endpoint (vLLM, LM Studio, Ollama, gateway)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=qwen2.5-coder:32b

# Source control. Needed for private repos and PR/MR creation.
TWEAKER_GITHUB_TOKEN=
TWEAKER_GITLAB_TOKEN=
# TWEAKER_GITHUB_BASE_URL=https://github.com
# TWEAKER_GITLAB_BASE_URL=https://gitlab.com

# Optional local checkout overrides, as JSON: {"owner/name": "/path"}
TWEAKER_REPO_MAP={}

# Demo/operator console
TWEAKER_DEMO_MODE=false
TWEAKER_PUBLIC_URL=http://localhost:8080
# TWEAKER_STATIC_DIR=./web/dist

# Slack / legacy webhook workflow (optional; not required for Sentry's UI)
TWEAKER_SLACK_SIGNING_SECRET=
TWEAKER_SLACK_BOT_TOKEN=
